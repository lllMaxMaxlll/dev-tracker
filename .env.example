# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (Drizzle)
# ─────────────────────────────────────────────────────────────────────────────
# Project Settings → Database → Connection string → URI (puerto 5432, directa).
# En Coolify corremos un proceso Node de larga vida, así que va la directa.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Usada sólo por drizzle-kit. Normalmente es la misma que DATABASE_URL.
DIRECT_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Cifrado de secretos guardados en la base (token de GitHub, API key propia)
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter (Fase 5)
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=DevTracker

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings — Cloudflare Workers AI por REST (Fase 6)
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDINGS_PROVIDER=workers-ai
EMBEDDINGS_MODEL=@cf/baai/bge-m3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Cron (Fase 6) — Scheduled Task de Coolify
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Acceso restringido (opcional). Vacío = cualquiera con cuenta de GitHub entra.
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_EMAILS=
ALLOWED_GITHUB_LOGINS=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ build-time: en Coolify va como build arg, no sólo como env de runtime.
NEXT_PUBLIC_APP_URL=http://localhost:3000
