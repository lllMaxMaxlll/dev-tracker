# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (Drizzle)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ OJO: hay DOS connection strings distintas y no son intercambiables.
#
# La DIRECTA (db.<ref>.supabase.co) resuelve SÓLO a IPv6 desde enero de 2024.
# Desde una red IPv4 tira `getaddrinfo ENOTFOUND`. Cloudflare sí la alcanza,
# así que:
#
#   • Hyperdrive (producción)  → connection string DIRECTA
#     Se carga al crear el binding, no vive en este archivo:
#     npx wrangler hyperdrive create devtracker-db --connection-string="<directa>"
#
#   • Este archivo (dev local y drizzle-kit) → SESSION POOLER, que es IPv4
#     Dashboard de Supabase → botón Connect → pestaña "Session pooler".
#     Formato: postgresql://postgres.<ref>:PASSWORD@aws-N-<region>.pooler.supabase.com:5432/postgres
#     Puerto 5432 = session mode. NO uses el 6543 (transaction mode): no
#     soporta bien los prepared statements ni el DDL de las migraciones.
#
# (La alternativa es contratar el add-on de IPv4 de Supabase y usar la directa
#  en todos lados, pero es pago.)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Hyperdrive en desarrollo: wrangler necesita una connection string real para
# emular el binding. Poné la misma que DATABASE_URL (el session pooler).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Cifrado de secretos guardados en la base (token de GitHub, API key propia)
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# IA — Cloudflare Workers AI (Fases 5 y 6)
# ─────────────────────────────────────────────────────────────────────────────
# NO hay API key: se accede por el binding `AI` declarado en wrangler.jsonc,
# tanto para el chat con tool calling como para los embeddings.
EMBEDDINGS_MODEL=@cf/baai/bge-m3

# ─────────────────────────────────────────────────────────────────────────────
# Cron (Fase 6) — Cron Trigger de Cloudflare Workers
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Acceso restringido (opcional). Vacío = cualquiera con cuenta de GitHub entra.
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_EMAILS=
ALLOWED_GITHUB_LOGINS=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ build-time: se hornea en el bundle del cliente durante `vinext build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000
