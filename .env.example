# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (Drizzle)
# ─────────────────────────────────────────────────────────────────────────────
# Connection string DIRECTA de Supabase (puerto 5432), no la pooled:
# Hyperdrive hace el pooling por su cuenta.
#
# En producción la conexión NO sale de acá sino del binding de Hyperdrive
# (ver wrangler.jsonc). DATABASE_URL se usa como fallback y para drizzle-kit.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Usada sólo por drizzle-kit. Normalmente es la misma que DATABASE_URL.
DIRECT_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Hyperdrive en desarrollo: wrangler necesita una connection string real para
# emular el binding. Poné la misma que DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Cifrado de secretos guardados en la base (token de GitHub, API key propia)
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter (Fase 5)
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=DevTracker

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings — Cloudflare Workers AI (Fase 6)
# ─────────────────────────────────────────────────────────────────────────────
# Al correr sobre Workers se usa el binding `AI` de wrangler.jsonc, así que NO
# hacen falta CLOUDFLARE_ACCOUNT_ID ni CLOUDFLARE_API_TOKEN.
EMBEDDINGS_PROVIDER=workers-ai
EMBEDDINGS_MODEL=@cf/baai/bge-m3
# OPENAI_API_KEY=   # sólo si EMBEDDINGS_PROVIDER=openai

# ─────────────────────────────────────────────────────────────────────────────
# Cron (Fase 6) — Cron Trigger de Cloudflare Workers
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Acceso restringido (opcional). Vacío = cualquiera con cuenta de GitHub entra.
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_EMAILS=
ALLOWED_GITHUB_LOGINS=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ build-time: se hornea en el bundle del cliente durante `vinext build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000
