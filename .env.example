# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Supabase self-hosted, gateway Kong en el puerto 8000.
# ⚠️ Esta URL tiene que ser alcanzable DESDE EL NAVEGADOR (el cliente la usa
#    para el OAuth y el refresco de token), no sólo desde el contenedor.
#    Con IP:8000 la app sólo anda en la LAN — para usarla desde el celular
#    hace falta un subdominio con TLS. Ver README.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tu-dominio.com
# ANON_KEY del .env del stack de Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE_ROLE_KEY del stack. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (Drizzle)
# ─────────────────────────────────────────────────────────────────────────────
# Postgres del stack de Supabase (POSTGRES_PASSWORD de su .env).
# Conexión directa: corremos un proceso Node de larga vida, no serverless.
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@<host>:5432/postgres
# Usada sólo por drizzle-kit. Normalmente es la misma que DATABASE_URL.
DIRECT_URL=postgresql://postgres:POSTGRES_PASSWORD@<host>:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Cifrado de secretos guardados en la base (token de GitHub, API key propia)
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter (Fase 5)
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=DevTracker

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings — Cloudflare Workers AI por REST (Fase 6)
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDINGS_PROVIDER=workers-ai
EMBEDDINGS_MODEL=@cf/baai/bge-m3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Cron (Fase 6) — Scheduled Task de Coolify
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Acceso restringido (opcional). Vacío = cualquiera con cuenta de GitHub entra.
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_EMAILS=
ALLOWED_GITHUB_LOGINS=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ build-time: en Coolify va como build arg, no sólo como env de runtime.
NEXT_PUBLIC_APP_URL=http://localhost:3000
