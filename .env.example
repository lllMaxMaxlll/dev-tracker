# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (Drizzle)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ OJO: hay DOS connection strings y no son intercambiables.
#
#   • DATABASE_URL → POOLER TRANSACCIONAL, puerto 6543
#     Es la que usa la app. En serverless las instancias aparecen y
#     desaparecen todo el tiempo; sin un pooler del lado del servidor la base
#     se queda sin conexiones. El modo transacción no soporta prepared
#     statements con nombre, pero drizzle sólo los usa si se pide `.prepare()`
#     explícitamente y en este proyecto no se usa en ningún lado.
#
#   • DIRECT_URL → SESSION POOLER, puerto 5432
#     Sólo la usa drizzle-kit: las migraciones necesitan una sesión de verdad
#     y hacen DDL, que el modo transacción no maneja bien.
#
# Las dos salen del dashboard de Supabase → botón Connect.
#
# La connection string DIRECTA (db.<ref>.supabase.co) no sirve para ninguna de
# las dos: resuelve sólo a IPv6 desde enero de 2024 y desde una red IPv4 tira
# `getaddrinfo ENOTFOUND`.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Cifrado de secretos guardados en la base (token de GitHub)
# ─────────────────────────────────────────────────────────────────────────────
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# IA — OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
# Una sola credencial para todo: OpenRouter sirve el chat con tool calling por
# /chat/completions y los embeddings por /embeddings. El modelo de cada tarea
# no se configura acá, sale de la tabla user_ai_settings (página de Ajustes).
#
# Sin esta variable la app arranca igual: las funciones de IA fallan con un
# mensaje accionable y el resto anda normal.
OPENROUTER_API_KEY=
# Opcionales: sólo sirven para que OpenRouter atribuya el consumo en su panel.
OPENROUTER_SITE_URL=https://devtracker.maxherr.com
OPENROUTER_APP_NAME=DevTracker

# ─────────────────────────────────────────────────────────────────────────────
# Cron — Vercel Cron Jobs (ver vercel.json)
# ─────────────────────────────────────────────────────────────────────────────
# Vercel manda esta clave como `Authorization: Bearer <CRON_SECRET>` en cada
# disparo, que es lo que valida /api/cron/weekly-summary.
# Generar con:  openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Acceso restringido (opcional). Vacío = cualquiera con cuenta de GitHub entra.
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_EMAILS=
ALLOWED_GITHUB_LOGINS=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ build-time: se hornea en el bundle del cliente durante `next build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000
